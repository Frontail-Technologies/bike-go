{
  "name": "ridego-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "build": "bun build --target bun --outdir dist src/index.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun src/libs/db/migrate.ts",
    "db:seed": "bun src/libs/db/seed.ts",
    "test": "bun test",
    "test:concurrency": "bun test tests/booking-concurrency.test.ts"
  },
  "dependencies": {
    "@elysia/cors": "2.0.0-rc.0",
    "@elysia/openapi": "2.0.0-rc.0",
    "better-auth": "1.7.12",
    "drizzle-orm": "0.45.4",
    "elysia": "2.0.0-rc.0",
    "exact-mirror": "1.2.6",
    "file-type": "21.0.0",
    "openapi-types": "12.1.3",
    "postgres": "3.4.9",
    "typebox": "1.4.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.11",
    "@eslint/js": "10",
    "@types/bun": "1.4.3",
    "drizzle-kit": "0.31.11",
    "eslint": "10.13.0",
    "typescript": "6",
    "typescript-eslint": "8.72.0"
  }
}
