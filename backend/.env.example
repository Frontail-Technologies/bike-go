# Runtime
NODE_ENV=development
PORT=4000

# PostgreSQL (required outside tests). Tests run on an in-memory PGlite database.
DATABASE_URL=postgres://ridego:ridego@localhost:5432/ridego

# Better Auth. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-random-string-of-at-least-32-characters
# Public base URL of this API (used for OAuth callbacks and cookies)
BETTER_AUTH_URL=http://localhost:4000

# Origins allowed to call the API with credentials (comma separated)
WEB_ORIGINS=http://localhost:3000

# Google sign-in (optional until configured)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Telegram Login Widget: the bot token that owns the widget's domain (optional until configured)
TELEGRAM_BOT_TOKEN=

# Where the local storage provider keeps private loan documents (development only)
STORAGE_DIR=./storage

# Pricing policy placeholders: confirm with the business before launch
TAX_RATE_BPS=1000
